#: src/Expired_License.php:117
#, php-format
msgid ""
"Your MyCryptoCheckout license has expired! If you wish to renew it, please "
"visit your <a href=\"%1$s\">account settings</a>. Or you can <a "
"href=\"%2$s\">dismiss this notice</a>."
msgstr ""
"Ihre MyCryptoCheckout-Lizenz ist abgelaufen! Wenn Sie sie verlängern "
"möchten, öffnen Sie Ihre <a href=\"%1$s\">Kontoeinstellungen</a>. Sie können"
" den <a href=\"%2$s\">Hinweis auch ausblenden</a>."

#: src/admin_trait.php:50
#, php-format
msgid ""
"Your PHP CURL module is missing. MyCryptoCheckout may not work 100%% well."
msgstr ""
"Ihr PHP-CURL-Modul fehlt. MyCryptoCheckout funktioniert möglicherweise nicht"
" zu 100%% einwandfrei."

#: src/admin_trait.php:64
#, php-format
msgid ""
"<strong>Keep Your Store Safe:</strong> Protect your site using our built-in "
"<strong>Hardening Tools</strong> (Admin Lockdown, Disable File Editors, "
"etc.) found in <a href=\"%1$s\">Global Settings &gt; Security</a>. We also "
"strongly recommend you <a href=\"%2$s\" target=\"_blank\" "
"rel=\"noopener\">enable login 2FA</a> and <a href=\"%3$s\" target=\"_blank\""
" rel=\"noopener\">Sucuri Monitor</a>."
msgstr ""
"<strong>Schützen Sie Ihren Shop:</strong> Schützen Sie Ihre Website mit "
"unseren integrierten <strong>Härtungswerkzeugen</strong> (Admin-Sperre, "
"Deaktivierung der Datei-Editoren usw.) unter <a href=\"%1$s\">Globale "
"Einstellungen &gt; Sicherheit</a>. Wir empfehlen ausserdem dringend, die <a "
"href=\"%2$s\" target=\"_blank\" rel=\"noopener\">Zwei-Faktor-"
"Authentifizierung für Anmeldungen zu aktivieren</a> und den <a href=\"%3$s\""
" target=\"_blank\" rel=\"noopener\">Sucuri Monitor</a> zu verwenden."

#: src/admin_trait.php:69 src/admin_trait.php:94
msgid "Dismiss this message."
msgstr "Diese Meldung ausblenden."

#: src/admin_trait.php:91
#, php-format
