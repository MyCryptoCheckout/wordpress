#: src/Expired_License.php:117
#, php-format
msgid ""
"Your MyCryptoCheckout license has expired! If you wish to renew it, please visit your <a "
"href=\"%1$s\">account settings</a>. Or you can <a href=\"%2$s\">dismiss this notice</a>."
msgstr ""
"Jūsų MyCryptoCheckout licencija nebegalioja! Jei norite ją pratęsti, atidarykite <a "
"href=\"%1$s\">paskyros nustatymus</a>. Taip pat galite <a href=\"%2$s\">paslėpti šį "
"pranešimą</a>."

#: src/admin_trait.php:50
#, php-format
msgid "Your PHP CURL module is missing. MyCryptoCheckout may not work 100%% well."
msgstr "Trūksta PHP cURL modulio. MyCryptoCheckout gali veikti ne 100%% tinkamai."

#: src/admin_trait.php:64
#, php-format
msgid ""
"<strong>Keep Your Store Safe:</strong> Protect your site using our built-in <strong>Hardening "
"Tools</strong> (Admin Lockdown, Disable File Editors, etc.) found in <a href=\"%1$s\">Global "
"Settings &gt; Security</a>. We also strongly recommend you <a href=\"%2$s\" target=\"_blank\" "
"rel=\"noopener\">enable login 2FA</a> and <a href=\"%3$s\" target=\"_blank\" "
"rel=\"noopener\">Sucuri Monitor</a>."
msgstr ""
"<strong>Apsaugokite savo parduotuvę:</strong> apsaugokite svetainę naudodami mūsų integruotus "
"<strong>saugumo stiprinimo įrankius</strong> (administratorių kūrimo blokavimą, failų redagavimo "
"priemonių išjungimą ir kt.), esančius skiltyje <a href=\"%1$s\">Visuotiniai nustatymai &gt; "
"Saugumas</a>. Taip pat primygtinai rekomenduojame <a href=\"%2$s\" target=\"_blank\" "
"rel=\"noopener\">įjungti prisijungimo dviejų veiksnių autentifikavimą</a> ir <a href=\"%3$s\" "
"target=\"_blank\" rel=\"noopener\">Sucuri Monitor</a>."

#: src/admin_trait.php:69 src/admin_trait.php:94
msgid "Dismiss this message."
msgstr "Paslėpti šį pranešimą."

#: src/admin_trait.php:91
#, php-format
msgid "Have you tried the <a href=\"%1$s\">new modern checkout style</a>?"
msgstr "Ar jau išbandėte <a href=\"%1$s\">naują modernų atsiskaitymo stilių</a>?"

