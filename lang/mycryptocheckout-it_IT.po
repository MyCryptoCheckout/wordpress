#: src/Expired_License.php:117
#, php-format
msgid "Your MyCryptoCheckout license has expired! If you wish to renew it, please visit your <a href=\"%1$s\">account settings</a>. Or you can <a href=\"%2$s\">dismiss this notice</a>."
msgstr "La licenza di MyCryptoCheckout è scaduta! Per rinnovarla, visita le <a href=\"%1$s\">impostazioni del tuo account</a>. In alternativa puoi <a href=\"%2$s\">ignorare questo avviso</a>."

